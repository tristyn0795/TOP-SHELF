{
  "id": "/",
  "name": "TOP SHELF",
  "short_name": "TOP SHELF",
  "description": "16-bit pro hockey: take over a club, play a friend on one screen, or online by room code.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0a1a6e",
  "theme_color": "#0a1a6e",
  "categories": [
    "games",
    "sports"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Continue season",
      "short_name": "Season",
      "url": "/?go=continue",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Exhibition game",
      "short_name": "Exhibition",
      "url": "/?go=exhibition",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/phone-game.webp",
      "sizes": "540x960",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Touch controls on a phone"
    },
    {
      "src": "/screenshots/landscape-game.webp",
      "sizes": "960x540",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Full-screen rink with a controller"
    }
  ]
}
